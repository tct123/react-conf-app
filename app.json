{
  "expo": {
    "name": "React Conf",
    "slug": "ReactConf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon-default.png",
    "scheme": "reactconfapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "de.cmg.ReactConf",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087EA4",
        "foregroundImage": "./assets/app-icons/icon-android.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/app-icons/icon-monochrome-android.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-asset",
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf3b2cfe-c59e-40d7-8648-6fb9f846ca2e"
      }
    }
  }
}
